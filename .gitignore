# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
# pnpm-lock.yaml
public/uploads
.claude
.spec-workflow
.ace-tool/
.env.local
.codex
.worktrees
.vscode
.gemini
.opencode
.npm-cache

# local agent and workspace state
/.agents/
/.pi/
/.codegraph/
/.impeccable/
/.cursor/
/.workbuddy/
/outputs/
/_tmp_*
/.aeroric/
/.tmp-*

# kilo / kilocode tooling
.kilo
.kilocode

# zcode tooling
.zcode/

# desktop client — now its own repository (github.com/ushaio/emulsion-desktop.git),
# no longer tracked by this repo. The local folder stays as a nested checkout.
/desktop/

# flutter mobile client — now its own repository (github.com/ushaio/emulsion-app.git),
# no longer tracked by this repo.
/flutter/

# shared packages — now in github.com/ushaio/mo-gallery-shared, consumed via
# pnpm git dependencies; local leftover folder (if any) is not tracked.
/packages/

# local temp artifacts
/tmp/
temp_screenshot.png
/.eslint-current.json

.pnpm-store/
.pencil-ui/
.env*
.tmp-go-cache/
.claude/

# docs
docs/

# merge/patch tool artifacts
*.orig
*.rej

# >>> Comet managed project state >>>
!/.comet/
/.comet/*
!/.comet/config.yaml
# <<< Comet managed project state <<<
