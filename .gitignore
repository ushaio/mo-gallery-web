# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
# pnpm-lock.yaml
public/uploads
.claude
.spec-workflow
.ace-tool/
.env.local
.codex
.worktrees
.vscode
.gemini
.opencode
.npm-cache

# local agent and workspace state
/.agents/
/.cursor/
/.workbuddy/
/outputs/
/_tmp_*
/.aeroric/
/.tmp-overview-*.tsx

# kilo / kilocode tooling
.kilo
.kilocode

# zcode tooling
.zcode/

# desktop client build artifacts
/desktop/testdata/local-library/manifest.local.json
/desktop/testdata/local-library/samples/
/desktop/testdata/local-library/reports/
/desktop/testdata/**/__pycache__/
/desktop/frontend/node_modules
/desktop/frontend/dist
/desktop/frontend/package.json.md5
/desktop/build/bin
/desktop/.tmp/
/desktop/.tmp-go-modcache/
/desktop/.tmp-go-cache-ui/
/desktop/**/*.go.[0-9]*
/desktop/frontend/.vite-dev.*.log
/desktop/build/runtime-package/
/desktop/build/generated/
/desktop/storage_plugins/runtime_assets/*
!/desktop/storage_plugins/runtime_assets/.gitkeep
*.bak

# flutter mobile client
/flutter/
!/flutter/
/flutter/*
!/flutter/lib/
!/flutter/lib/**
!/flutter/test/
!/flutter/test/**
!/flutter/pubspec.yaml
!/flutter/pubspec.lock
/flutter/.dart_tool/
/flutter/build/
/flutter/.flutter-plugins
/flutter/.flutter-plugins-dependencies
/flutter/.packages
/flutter/**/GeneratedPluginRegistrant.*

# workspace package dependency links
/packages/*/node_modules/
/packages/*/dist/
.pnpm-store/
.pencil-ui/
.env*
.tmp-go-cache/
.claude/
# >>> Comet managed project state >>>
