/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
# pnpm-lock.yaml
public/uploads
.claude
.spec-workflow
.ace-tool/
.env.local
.codex
.worktrees
.vscode
.gemini
.opencode
.npm-cache

# local agent and workspace state
/.agents/
/.pi/
/.codegraph/
/.impeccable/
/.cursor/
/.workbuddy/
/outputs/
/_tmp_*
/.aeroric/
/.tmp-*

# kilo / kilocode tooling
.kilo
.kilocode

# zcode tooling
.zcode/

# 多仓库布局：本仓库只负责 web。桌面端、Flutter 客户端、共享包分别是同级目录下的
# 独立 checkout（../emulsion-desktop、../emulsion-app、../mo-gallery-shared），各自对应独立 GitHub 仓库
# （emulsion-desktop / emulsion-app / mo-gallery-shared），不再由本仓库跟踪。
# 下面三条规则保留，用于兜底忽略历史遗留或工具在本仓库内再生成同名目录的情况。
/desktop/
/flutter/
/packages/

# local temp artifacts
/tmp/
temp_screenshot.png
/.eslint-current.json

.pnpm-store/
.pencil-ui/
.env*
.tmp-go-cache/
.claude/

# docs
docs/

# merge/patch tool artifacts
*.orig
*.rej

# >>> Comet managed project state >>>
!/.comet/
/.comet/*
!/.comet/config.yaml
# <<< Comet managed project state <<<
