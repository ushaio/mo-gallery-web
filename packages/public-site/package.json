{
  "name": "@mo-gallery/public-site",
  "version": "0.1.0",
  "private": true,
  "description": "Shared visitor-site components for personal public sites. Host-agnostic: data, routing and media URL resolution are injected by the host (Web global scope, Official per-user scope).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/styles/web-theme.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mo-gallery/content-core": "workspace:*",
    "@mo-gallery/milkdown": "workspace:*",
    "@mo-gallery/tiptap-editor": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "next": ">=14"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
